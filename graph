#include <stdio.h>
#include<stdlib.h>
#define Max 100
int n;
int adjMatrix[Max][Max];
void insertEdge(int u, int v)
{
    adjMatrix[u][v] = 1;
    adjMatrix[v][u] = 1;
    printf("Edge Inserted!!!\n");
}
void bfs(int start){
    int queue[Max], front = -1, rear = -1;
    int visited[n];
    for(int i=0; i<n; i++)
      visited[i]=0;
      printf("BFS Traversal : ");
      queue[++rear]= start;
      visited[start] = 1;
      front++;
      while(front<=rear){
        int v = queue[front++];
        printf("%d", v);
        for(int i=0; i<n; i++){
            if(visited[i]== 0&& adjMatrix[v][i] == 1){
            visited[i] = 1;
            queue[++rear] = i;
            }
        }
      }
      printf("\n");
}
void dfs(int start){
    int stack[Max], top = -1;
    int visited[n];
    for(int i=0; i<n; i++)
    visited[i]= 0;
    printf("DFS Traversal : ");
    stack[++top] = start;
    while(top != -1){
        int v = stack[top--];
        if(visited[v]==0){
            printf("%d", v);
            visited[v] = 1;
        }
        for(int i=0; i<n; i++){
            if(adjMatrix[v][i ==1 && visited[i]==0])
            stack[++top] = i;
        }
    }
    printf("\n");
}
int main()
{
    printf("Enter number of vertexs: ");
    scanf("%d", &n);
    int choice, u, v;           
    while (1)
    {
        printf("1.Insert edge in graph\n");
        printf("2. BFS traversal\n");
        printf("3. DFS traversal\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);
        switch (choice)
        {
        case 1:
            printf("Enter Edge(U,V): ");
            scanf("%d%d, &u , &v");
            insertEdge(u, v);
            break;
        case 2:
            break;
        case 3:
            break;
        case 4:
            exit(0);
        default:
            printf("Invalid choice!!!\n");
        }
    }
}
